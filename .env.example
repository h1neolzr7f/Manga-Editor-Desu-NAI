# Copy to .env (optional). start_manga_editor_nai.ps1 also reads this file.
# Manga Editor Desu · nai学长魔改版 1.0.0 — do not commit .env or API tokens.
# API tokens are kept in the current browser session only, not localStorage.
# The local proxy binds 127.0.0.1 by default and will not serve .env.

NOVELAI_API_KEY=
TOKENDANCE_API_KEY=
DIRECTOR_API_URL=https://tokendance.space/gateway/v1/chat/completions
DIRECTOR_MODEL=deepseek-v4-flash
NOVELAI_MODEL=nai-diffusion-4-5-full

# Optional: bind all interfaces. Default is 127.0.0.1.
# NAI_BIND=127.0.0.1

# Smoke test: set to 1 to skip spending one NAI image credit
# NAI_SMOKE_SKIP_GENERATE=1
