# Copy to .env (optional). start_manga_editor_nai.ps1 also reads this file.
# Tokens are normally saved in the app UI (localStorage) — smoke test can read from browser too.

NOVELAI_API_KEY=
TOKENDANCE_API_KEY=
DIRECTOR_API_URL=https://tokendance.space/gateway/v1/chat/completions
DIRECTOR_MODEL=deepseek-v4-flash
NOVELAI_MODEL=nai-diffusion-4-5-full

# Smoke test: set to 1 to skip spending one NAI image credit
# NAI_SMOKE_SKIP_GENERATE=1